# Convex deployment URL (set by init_app_project tool or npx convex dev)
VITE_CONVEX_URL=

# For local development with npx convex dev
# CONVEX_DEPLOY_KEY=

# Auth private key (RSA 2048, generated automatically)
# AUTH_PRIVATE_KEY=

# Preview flag (staging only)
# IS_PREVIEW=true

# HMAC SSO mesh secret (required; guards /admin/ endpoints + SSO token verify)
# SSO_SHARED_SECRET=

# SMTP email sending (OTP + password reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ScreenshotOne access key for the update regression before/after screenshots
# (convex/viktorTools.ts takeScreenshot)
# SCREENSHOT_API_KEY=